---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getFolder, getFolders } from "../../folders";
import { LEVELS, readingTime, splitTags, tagSlug } from "../../reading";

export async function getStaticPaths() {
  const blogEntries = await getCollection("blog");
  return blogEntries.map((entry) => ({ params: { slug: entry.id } }));
}

const entry = await getEntry("blog", Astro.params.slug);
if (!entry) {
  return new Response(null, { status: 404, statusText: "Not found" });
}

const { Content, headings } = await render(entry);
const formattedDate = entry.data.pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const { minutes, brew } = readingTime(entry);
const { level, subjects } = splitTags(entry.data.tags);

// Contents: h2s, with their h3s nested underneath
const toc: { slug: string; text: string; children: { slug: string; text: string }[] }[] = [];
for (const h of headings) {
  if (h.depth === 2) toc.push({ slug: h.slug, text: h.text, children: [] });
  else if (h.depth === 3 && toc.length) toc[toc.length - 1].children.push({ slug: h.slug, text: h.text });
}

// Where this post sits in its folder, if it has one
const folder = entry.data.series ? await getFolder(entry.data.series) : undefined;
const volume = folder ? (await getFolders()).findIndex((f) => f.id === folder.id) + 1 : 0;
const position = folder ? folder.posts.findIndex((p) => p.id === entry.id) : -1;
const prevPost = folder && position > 0 ? folder.posts[position - 1] : undefined;
const nextPost = folder && position >= 0 ? folder.posts[position + 1] : undefined;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={`/og/${entry.id.replace(/\/index$/, "")}.png`}
  type="article"
  publishedTime={entry.data.pubDate}
  modifiedTime={entry.data.updatedDate}
  tags={entry.data.tags}
>
  <div class="progress" aria-hidden="true"><span id="progress-bar"></span></div>
  <Header />

  <main>
    <article class="post" style={folder ? `--leather: ${folder.color}` : undefined}>
      <header class="post-header">
        {folder && position >= 0 && (
          <a class="volume" href={`/series/${folder.id}`}>
            <span class="swatch" aria-hidden="true"></span>
            Vol. {String(volume).padStart(2, "0")} · {folder.title} · Chapter #{position + 1} of {folder.posts.length}
          </a>
        )}
        <h1>{entry.data.title}</h1>
        <p class="post-description">{entry.data.description}</p>

        <div class="post-meta">
          <time datetime={entry.data.pubDate.toISOString()}>{formattedDate}</time>
          <span class="dot" aria-hidden="true">·</span>
          <span class="brew">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path class="steam" d="M8 2c0 1.5 1 1.5 1 3M12 2c0 1.5 1 1.5 1 3" />
              <path d="M4 8h13v5a6 6 0 0 1-6 6h-1a6 6 0 0 1-6-6V8z" />
              <path d="M17 10h1.5a2.5 2.5 0 0 1 0 5H17" />
              <path d="M3 22h16" />
            </svg>
            {minutes} min read · {brew}
          </span>
          {level > 0 && (
            <>
              <span class="dot" aria-hidden="true">·</span>
              <span class="level">
                <span class="beans" aria-hidden="true">
                  {LEVELS.map((_, i) => (
                    <svg viewBox="0 0 10 14" width="9" height="12" class:list={{ roasted: i < level }}>
                      <ellipse cx="5" cy="7" rx="4.2" ry="6.2" />
                      <path d="M5 1.2c-1.8 2.4 1.8 4.6 0 11.6" fill="none" />
                    </svg>
                  ))}
                </span>
                <span class="level-name">{LEVELS[level - 1]}</span>
              </span>
            </>
          )}
        </div>
      </header>

      <div class="post-body">
        {toc.length > 1 && (
          <aside class="toc" aria-label="Contents">
            <details class="toc-box" id="toc-box" open>
              <summary>
                <span>Contents</span>
                <span class="toc-count">{toc.length} sections</span>
              </summary>
              <ol class="toc-list">
                {toc.map((item) => (
                  <li>
                    <a href={`#${item.slug}`} data-toc={item.slug}>{item.text}</a>
                    {item.children.length > 0 && (
                      <ol>
                        {item.children.map((child) => (
                          <li><a href={`#${child.slug}`} data-toc={child.slug}>{child.text}</a></li>
                        ))}
                      </ol>
                    )}
                  </li>
                ))}
              </ol>
              <p class="toc-progress"><span id="toc-percent">0</span>% read</p>
            </details>
          </aside>
        )}

        <div class="post-content" id="post-content">
          <Content />
          <p class="fin" aria-hidden="true">❦</p>
        </div>
      </div>

      <footer class="post-footer">
        {subjects.length > 0 && (
          <div class="filed">
            <span class="filed-label">Filed under</span>
            <ul>
              {subjects.map((tag) => (
                <li><a href={`/tags/${tagSlug(tag)}`}>{tag.replace(/-/g, " ")}</a></li>
              ))}
            </ul>
          </div>
        )}

        {folder && (prevPost || nextPost) && (
          <nav class="series-nav" aria-label={`More in ${folder.title}`}>
            {prevPost ? (
              <a class="prev" href={`/blog/${prevPost.id}`}>
                <span class="label">← Chapter #{position} · Previous</span>
                <span class="title">{prevPost.data.title}</span>
              </a>
            ) : <span />}
            {nextPost && (
              <a class="next" href={`/blog/${nextPost.id}`}>
                <span class="label">Next · Chapter #{position + 2} →</span>
                <span class="title">{nextPost.data.title}</span>
              </a>
            )}
          </nav>
        )}

        <a class="back-shelf" href={folder ? `/series/${folder.id}` : "/blog"}>
          {folder ? `See every chapter in ${folder.title}` : "Browse the archive"} →
        </a>
      </footer>
    </article>
  </main>

  <Footer />

  <button id="back-to-top" class="back-to-top" type="button" aria-label="Back to top" hidden>
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="18 15 12 9 6 15"></polyline>
    </svg>
  </button>
</BaseLayout>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const content = document.getElementById("post-content");
  const bar = document.getElementById("progress-bar");
  const percent = document.getElementById("toc-percent");
  const btn = document.getElementById("back-to-top");
  const SHOW_AFTER = 400; // px scrolled before back-to-top appears
  let hideTimer: number | undefined;
  let ticking = false;

  // Reading progress and back-to-top, both driven by one scroll handler
  const update = () => {
    ticking = false;
    if (content) {
      const start = content.offsetTop;
      const end = start + content.offsetHeight - window.innerHeight;
      const p = Math.min(1, Math.max(0, (window.scrollY - start) / Math.max(1, end - start)));
      if (bar) bar.style.transform = `scaleX(${p})`;
      if (percent) percent.textContent = String(Math.round(p * 100));
    }
    if (btn) {
      clearTimeout(hideTimer);
      if (window.scrollY > SHOW_AFTER) {
        btn.hidden = false;
        requestAnimationFrame(() => btn.classList.add("visible"));
      } else {
        btn.classList.remove("visible");
        hideTimer = window.setTimeout(() => (btn.hidden = true), 300);
      }
    }
  };
  window.addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    },
    { passive: true },
  );
  window.addEventListener("resize", update);
  update();

  btn?.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
  });

  // Contents: collapsed by default on small screens, highlight the section being read
  const box = document.getElementById("toc-box") as HTMLDetailsElement | null;
  const desktop = window.matchMedia("(min-width: 1200px)");
  const syncBox = () => {
    if (box) box.open = desktop.matches;
  };
  syncBox();
  desktop.addEventListener("change", syncBox);

  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>("[data-toc]")].map((a) => [a.dataset.toc!, a]),
  );
  if (links.size && content) {
    const headings = [...content.querySelectorAll<HTMLElement>("h2[id], h3[id]")].filter((h) => links.has(h.id));
    const setActive = () => {
      const line = window.innerHeight * 0.25;
      let current = headings[0];
      for (const h of headings) {
        if (h.getBoundingClientRect().top <= line) current = h;
      }
      links.forEach((a) => a.classList.remove("active"));
      const active = current && links.get(current.id);
      if (active) {
        active.classList.add("active");
        if (box && desktop.matches && box.scrollHeight > box.clientHeight) {
          const a = active.getBoundingClientRect();
          const b = box.getBoundingClientRect();
          if (a.top < b.top + 40 || a.bottom > b.bottom - 40) {
            box.scrollTop += a.top - b.top - box.clientHeight / 2;
          }
        }
        active.closest("ol")?.closest("li")?.querySelector(":scope > a")?.classList.add("active");
      }
    };
    window.addEventListener("scroll", () => requestAnimationFrame(setActive), { passive: true });
    setActive();

    // On small screens, close the contents after jumping to a section
    links.forEach((a) =>
      a.addEventListener("click", () => {
        if (box && !desktop.matches) box.open = false;
      }),
    );
  }

  // Heading anchors: a small link beside each section title
  content?.querySelectorAll<HTMLElement>("h2[id], h3[id]").forEach((h) => {
    const a = document.createElement("a");
    a.href = `#${h.id}`;
    a.className = "anchor";
    a.setAttribute("aria-label", `Link to “${h.textContent}”`);
    a.textContent = "#";
    h.appendChild(a);
  });
</script>

<style>
  /* ---------- Reading progress ---------- */
  .progress {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 1100;
    pointer-events: none;
  }

  .progress span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--leather, var(--accent-color)), var(--accent-color));
    transform-origin: left;
    transform: scaleX(0);
  }

  /* ---------- Layout ---------- */
  .post {
    --measure: 68ch;
    padding: 48px 16px 80px;
  }

  .post-header,
  .post-footer {
    max-width: var(--measure);
    margin: 0 auto;
  }

  .post-body {
    display: grid;
    grid-template-columns: minmax(0, var(--measure));
    justify-content: center;
    gap: 0 56px;
  }

  @media (min-width: 1200px) {
    .post-body {
      /* contents on the left, reading column centred on the page */
      grid-template-columns: 1fr minmax(0, var(--measure)) 1fr;
    }
    .toc {
      grid-column: 1;
      justify-self: end;
      width: min(240px, 100%);
    }
    .post-content {
      grid-column: 2;
      grid-row: 1;
    }
  }

  /* ---------- Header ---------- */
  .post-header {
    padding: 20px 0 40px;
    margin-bottom: 40px;
    border-bottom: 1px solid var(--border-color);
    text-align: center;
  }

  .volume {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-color);
    text-decoration: none;
  }

  .volume:hover {
    color: var(--heading-color);
  }

  .swatch {
    width: 8px;
    height: 12px;
    border-radius: 1px 2px 2px 1px;
    background: var(--leather);
    box-shadow: inset 2px 0 0 rgba(0, 0, 0, 0.3);
  }

  .post-header h1 {
    font-size: clamp(2rem, 1.2rem + 3.2vw, 3.2rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin-bottom: 18px;
    color: var(--heading-color);
    text-wrap: balance;
  }

  .post-description {
    max-width: 600px;
    margin: 0 auto 26px;
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
    font-style: italic;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 6px 12px;
    font-size: 0.88rem;
  }

  .dot {
    opacity: 0.5;
  }

  .brew,
  .level {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .brew {
    font-weight: 700;
    color: var(--heading-color);
  }

  .steam {
    animation: steam 2.8s ease-in-out infinite;
  }

  @keyframes steam {
    0%, 100% { opacity: 0.3; transform: translateY(1px); }
    50% { opacity: 1; transform: translateY(-1px); }
  }

  .beans {
    display: inline-flex;
    gap: 3px;
  }

  .beans svg {
    fill: transparent;
    stroke: color-mix(in srgb, var(--text-color) 40%, transparent);
    stroke-width: 1;
  }

  .beans svg.roasted {
    fill: var(--accent-color);
    stroke: var(--heading-color);
  }

  .beans svg.roasted path {
    stroke: var(--card-bg-color);
  }

  .level-name {
    text-transform: capitalize;
  }

  /* ---------- Contents ---------- */
  .toc {
    margin-bottom: 36px;
  }

  @media (min-width: 1200px) {
    .toc {
      margin-bottom: 0;
    }
    .toc-box {
      position: sticky;
      top: 32px;
      max-height: calc(100vh - 64px);
      /* very long contents scroll, but without a visible scrollbar */
      overflow: hidden auto;
      scrollbar-width: none;
    }
    .toc-box::-webkit-scrollbar {
      display: none;
    }
  }

  .toc-box {
    border: 1px solid var(--border-color);
    border-radius: 8px;
    background: var(--card-bg-color);
    padding: 4px 18px;
  }

  .toc-box summary {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 12px 0;
    cursor: pointer;
    list-style: none;
    font-family: "Playfair Display", serif;
    font-style: italic;
    font-weight: 700;
    color: var(--heading-color);
  }

  .toc-box summary::-webkit-details-marker {
    display: none;
  }

  .toc-box summary::after {
    content: "";
    width: 7px;
    height: 7px;
    margin-left: 10px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg) translateY(-3px);
    transition: transform 0.2s ease;
  }

  .toc-box[open] summary::after {
    transform: rotate(-135deg);
  }

  .toc-count {
    margin-left: auto;
    font-family: "Lora", serif;
    font-size: 0.75rem;
    font-weight: 400;
    opacity: 0.7;
  }

  .toc-list,
  .toc-list ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc-list {
    padding-bottom: 6px;
    counter-reset: section;
  }

  .toc-list > li {
    counter-increment: section;
  }

  .toc-list a {
    position: relative;
    display: block;
    padding: 5px 0 5px 14px;
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--text-color);
    text-decoration: none;
    border-left: 2px solid var(--border-color);
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .toc-list > li > a::before {
    content: counter(section) ". ";
    color: var(--accent-color);
    font-variant-numeric: tabular-nums;
  }

  .toc-list ol a {
    padding-left: 28px;
    font-size: 0.8rem;
    opacity: 0.85;
  }

  .toc-list a:hover {
    color: var(--heading-color);
  }

  .toc-list a.active {
    color: var(--heading-color);
    font-weight: 700;
    border-left-color: var(--accent-color);
  }

  .toc-progress {
    margin: 0;
    padding: 10px 0 12px;
    border-top: 1px dashed var(--border-color);
    font-size: 0.75rem;
    font-style: italic;
    opacity: 0.75;
  }

  /* ---------- Article text ---------- */
  .post-content {
    min-width: 0;
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--text-color);
    overflow-wrap: break-word;
  }

  @media (max-width: 600px) {
    .post-content {
      font-size: 1.0625rem;
      line-height: 1.75;
    }
  }

  .post-content :global(p) {
    margin: 0 0 1.4em;
    text-wrap: pretty;
  }

  /* drop cap on the opening paragraph */
  .post-content > :global(p:first-of-type::first-letter) {
    float: left;
    font-family: "Playfair Display", serif;
    font-size: 3.4em;
    line-height: 0.8;
    margin: 0.08em 0.1em 0 0;
    color: var(--accent-color);
  }

  .post-content :global(h2),
  .post-content :global(h3),
  .post-content :global(h4) {
    position: relative;
    scroll-margin-top: 24px;
    color: var(--heading-color);
    text-wrap: balance;
  }

  .post-content :global(h2) {
    font-size: clamp(1.5rem, 1.25rem + 1vw, 1.9rem);
    line-height: 1.25;
    margin: 2.4em 0 0.8em;
  }

  .post-content :global(h3) {
    font-size: clamp(1.2rem, 1.1rem + 0.5vw, 1.4rem);
    line-height: 1.3;
    margin: 1.9em 0 0.6em;
  }

  /* the header already provides the space above the opening section */
  .post-content > :global(:is(h2, h3):first-child) {
    margin-top: 0;
  }

  .post-content :global(.anchor) {
    margin-left: 0.4em;
    font-family: "Lora", serif;
    font-weight: 400;
    color: var(--accent-color);
    text-decoration: none;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .post-content :global(h2:hover .anchor),
  .post-content :global(h3:hover .anchor),
  .post-content :global(.anchor:focus-visible) {
    opacity: 0.8;
  }

  .post-content :global(a:not(.anchor)) {
    color: var(--heading-color);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent-color) 55%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: text-decoration-color 0.2s ease;
  }

  .post-content :global(a:not(.anchor):hover) {
    text-decoration-color: currentColor;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 0 0 1.4em;
    padding-left: 1.4em;
  }

  .post-content :global(li) {
    margin-bottom: 0.4em;
  }

  .post-content :global(li::marker) {
    color: var(--accent-color);
  }

  .post-content :global(strong) {
    color: var(--heading-color);
  }

  .post-content :global(hr) {
    border: none;
    margin: 2.8em 0;
    text-align: center;
  }

  .post-content :global(hr)::after {
    content: "· · ·";
    letter-spacing: 0.6em;
    color: var(--accent-color);
  }

  .post-content :global(blockquote) {
    margin: 1.8em 0;
    padding: 18px 22px;
    border-left: 3px solid var(--accent-color);
    border-radius: 0 8px 8px 0;
    background: var(--card-bg-color);
    font-style: italic;
  }

  .post-content :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .post-content :global(img) {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 2em auto;
    border-radius: 8px;
  }

  /* inline code */
  .post-content :global(:not(pre) > code) {
    padding: 0.1em 0.35em;
    border: 1px solid var(--border-color);
    border-radius: 4px;
    background: var(--card-bg-color);
    font-size: 0.88em;
    overflow-wrap: anywhere;
  }

  /* ---------- Code blocks ---------- */
  .post-content :global(.code-block),
  .post-content :global(pre) {
    margin: 1.8em 0;
  }

  .post-content :global(.code-block pre) {
    margin: 0;
  }

  .post-content :global(pre) {
    padding: 18px 20px;
    border-radius: 8px;
    overflow-x: auto;
    white-space: pre;
    -webkit-overflow-scrolling: touch;
    font-size: 0.85rem;
    line-height: 1.65;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.25) transparent;
  }

  .post-content :global(pre::-webkit-scrollbar) {
    height: 8px;
  }

  .post-content :global(pre::-webkit-scrollbar-thumb) {
    background: rgba(255, 255, 255, 0.22);
    border-radius: 4px;
  }

  .post-content :global(pre::-webkit-scrollbar-track) {
    background: transparent;
  }

  .post-content :global(pre code) {
    padding: 0;
    border: none;
    background: none;
    font-size: inherit;
    white-space: inherit;
  }

  /* diagrams: a paper panel that follows the theme, scrolling sideways if wide */
  .post-content :global(pre.mermaid) {
    padding: 20px;
    overflow-x: auto;
    text-align: center;
    background: var(--card-bg-color) !important;
    border: 1px solid var(--border-color);
    border-radius: 10px;
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    scrollbar-color: var(--border-color) transparent;
  }

  @media (max-width: 600px) {
    .post-content :global(.code-block),
    .post-content :global(pre:not(.code-block pre, .mermaid)) {
      margin-left: -16px;
      margin-right: -16px;
      border-radius: 0;
    }
    .post-content :global(pre) {
      padding: 14px 16px;
      font-size: 0.78rem;
    }
  }

  /* ---------- Tables: scroll sideways instead of squashing ---------- */
  .post-content :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    margin: 1.8em 0;
    border-collapse: collapse;
    font-size: 0.92em;
    line-height: 1.5;
    scrollbar-width: thin;
    scrollbar-color: var(--border-color) transparent;
  }

  .post-content :global(th),
  .post-content :global(td) {
    padding: 10px 14px;
    border-bottom: 1px solid var(--border-color);
    text-align: left;
