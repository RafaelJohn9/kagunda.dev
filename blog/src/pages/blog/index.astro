---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ArticleCard from '../../components/ArticleCard.astro';

// Every published article, newest first, shelved by year
const posts = (await getCollection('blog', ({ data }) => !data.draft && !!data.category)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const years = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.pubDate.getFullYear();
  years.set(year, [...(years.get(year) ?? []), post]);
}
---

<BaseLayout title="Archive" description="Every article on kagunda.dev, newest first.">
  <Header />

  <main>
    <section class="page-header">
      <div class="container">
        <p class="kicker">The archive</p>
        <h1>Every chapter so far</h1>
        <p class="intro">{posts.length} articles, newest first.</p>
      </div>
    </section>

    <section class="archive">
      <div class="container">
        {[...years].map(([year, yearPosts]) => (
          <div class="year">
            <h2>
              <span>{year}</span>
              <small>{yearPosts.length} {yearPosts.length === 1 ? 'article' : 'articles'}</small>
            </h2>
            <div class="list">
              {yearPosts.map((post) => <ArticleCard post={post} />)}
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page-header {
    padding: 80px 0 30px;
    text-align: center;
  }

  .kicker {
    margin: 0 0 10px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent-color);
  }

  .page-header h1 {
    font-size: 3rem;
    color: var(--heading-color);
    margin-bottom: 12px;
  }

  .intro {
    font-style: italic;
  }

  .archive {
    padding-top: 20px;
  }

  .year {
    max-width: 820px;
    margin: 0 auto 60px;
  }

  .year h2 {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 18px;
    font-size: 2rem;
    color: var(--heading-color);
  }

  .year h2 small {
    font-family: 'Lora', serif;
    font-size: 0.85rem;
    font-weight: 400;
    font-style: italic;
    opacity: 0.7;
  }

  @media (max-width: 768px) {
    .page-header h1 {
      font-size: 2.2rem;
    }
  }
</style>
