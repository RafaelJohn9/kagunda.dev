---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getFolders } from '../folders';

const folders = await getFolders();
const posts = await getCollection('blog', ({ data }) => !data.draft && !!data.category);
const chapterUrls = posts.map((post) => `/blog/${post.id}`);

// Each volume becomes a book on the shelf: fatter for more chapters, heights varied
const HEIGHTS = [206, 228, 194, 218, 200];
const books = folders.map((folder, i) => ({
  href: `/series/${folder.id}`,
  title: folder.title,
  color: folder.color,
  vol: String(i + 1).padStart(2, '0'),
  height: HEIGHTS[i % HEIGHTS.length],
  thickness: 34 + Math.min(folder.posts.length, 5) * 4,
}));
// The missing page leaves a gap in the middle of the shelf
const gapAt = Math.ceil(books.length / 2);

// A ceramic mug approximated by a ring of thin faces, shaded against a light from the upper left
const MUG_R = 30;
const MUG_SIDES = 28;
const faceWidth = 2 * MUG_R * Math.tan(Math.PI / MUG_SIDES) + 1.2;
const mugFaces = Array.from({ length: MUG_SIDES }, (_, i) => {
  const angle = (i * 360) / MUG_SIDES;
  const light = Math.cos(((angle + 40) * Math.PI) / 180); // -1..1
  return { angle, lightness: 80 + light * 10 };
});
---

<BaseLayout title="Page not found" description="This chapter isn't on the shelf.">
  <Header />

  <main class="nf">
    <section class="stage" aria-hidden="true">
      <div class="scene" id="scene">
        <div class="world" id="world">
          <div class="row">
            {books.map((book, i) => (
              <>
                {i === gapAt && (
                  <div class="gap">
                    <span class="gap-card">404</span>
                  </div>
                )}
                <a
                  class:list={['book', { leaning: i === gapAt }]}
                  href={book.href}
                  tabindex="-1"
                  style={`--leather: ${book.color}; --h: ${book.height}px; --t: ${book.thickness}px`}
                >
                  <span class="face spine">
                    <span class="band"></span>
                    <span class="spine-title">{book.title}</span>
                    <span class="spine-vol">{book.vol}</span>
                  </span>
                  <span class="face side left"></span>
                  <span class="face side right"></span>
                  <span class="face top"></span>
                  <span class="face back"></span>
                </a>
              </>
            ))}

            <div class="mug">
              {mugFaces.map((f) => (
                <span
                  class="mug-face"
                  style={`transform: rotateY(${f.angle}deg) translateZ(${MUG_R}px); width: ${faceWidth}px; margin-left: ${-faceWidth / 2}px; background: hsl(36 38% ${f.lightness}%)`}
                ></span>
              ))}
              <span class="mug-rim"></span>
              <span class="mug-coffee"></span>
              <span class="mug-handle"></span>
              <span class="steam s1"></span>
              <span class="steam s2"></span>
              <span class="steam s3"></span>
            </div>
          </div>

          <div class="plank">
            <span class="plank-top"></span>
            <span class="plank-front"></span>
            <span class="plank-end l"></span>
            <span class="plank-end r"></span>
          </div>
        </div>
        <div class="floor-shadow"></div>
      </div>
    </section>

    <section class="copy">
      <div class="container">
        <p class="kicker">Error 404 · Missing from the shelf</p>
        <h1>This chapter hasn't been written</h1>
        <p class="lede">
          The page you're after isn't where it should be. It may have been moved or renamed, or it's
          still a draft sitting next to a cold cup of coffee.
        </p>
        <p class="hint">Pull a book off the shelf above, or try one of these:</p>

        <div class="actions">
          <a class="btn primary" href="/">Back to the shelf</a>
          <button class="btn" type="button" id="random-chapter" data-urls={JSON.stringify(chapterUrls)}>
            Read a random chapter
          </button>
          <a class="btn" href="/blog">Browse the archive</a>
        </div>

        <nav class="quick" aria-label="More places to look">
          <a href="/tutorials">Tutorials</a>
          <a href="/writings">Writings</a>
          <a href="/library">Library</a>
          <a href="/tags">Topics</a>
          <a href="/about">About</a>
        </nav>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .nf {
    overflow-x: clip;
  }

  /* ---------- 3D stage ---------- */
  .stage {
    padding: 40px 0 0;
    display: flex;
    justify-content: center;
  }

  .scene {
    --plank-w: 560px;
    --depth: 150px;
    --plank-d: 176px;
    --plank-t: 20px;
    position: relative;
    width: var(--plank-w);
    height: 300px;
    perspective: 1100px;
    perspective-origin: 50% 20%;
  }

  .world {
    --rx: -14deg;
    --ry: -22deg;
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform 0.25s ease-out;
    animation: sway 9s ease-in-out infinite;
  }

  .world.tracking {
    animation: none;
  }

  @keyframes sway {
    0%, 100% { transform: rotateX(var(--rx)) rotateY(-22deg); }
    50% { transform: rotateX(var(--rx)) rotateY(-8deg); }
  }

  .row {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(var(--plank-t) + 20px);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 3px;
    transform-style: preserve-3d;
  }

  /* ---------- Books: a box of five faces ---------- */
  .book {
    position: relative;
    width: var(--t);
    height: var(--h);
    flex-shrink: 0;
    transform-style: preserve-3d;
    transition: transform 0.45s cubic-bezier(0.3, 0.8, 0.3, 1);
    text-decoration: none;
  }

  .book:hover {
    transform: translateZ(46px) translateY(-6px);
  }

  .book.leaning {
    transform-origin: 0 100%;
    transform: rotateZ(-13deg);
    margin-left: 2px;
  }

  .book.leaning:hover {
    transform: rotateZ(-13deg) translateZ(46px);
  }

  .face {
    position: absolute;
    backface-visibility: hidden;
  }

  .spine {
    inset: 0;
    transform: translateZ(calc(var(--depth) / 2));
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 14px 0 12px;
    border-radius: 3px;
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.35), rgba(255, 255, 255, 0.12) 45%, rgba(0, 0, 0, 0.3)),
      var(--leather);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.25);
  }

  .band {
    width: 100%;
    height: 7px;
    border-top: 1px solid #e6c38a;
    border-bottom: 1px solid #e6c38a;
    opacity: 0.7;
  }

  .spine-title {
    flex: 1;
    margin: 12px 0;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: 'Playfair Display', serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #e6c38a;
    white-space: nowrap;
    overflow: hidden;
    text-shadow: 0 1px 0 rgba(0, 0, 0, 0.4);
  }

  .spine-vol {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: rgba(230, 195, 138, 0.8);
  }

  .side {
    top: 0;
    width: var(--depth);
    height: var(--h);
    left: calc((var(--t) - var(--depth)) / 2);
    background:
      linear-gradient(rgba(0, 0, 0, 0.1), rgba(0, 0, 0, 0.3)),
      var(--leather);
  }

  .side.left {
    transform: rotateY(-90deg) translateZ(calc(var(--t) / 2));
  }

  .side.right {
    transform: rotateY(90deg) translateZ(calc(var(--t) / 2));
    filter: brightness(0.7);
  }

  /* page edges, seen from above */
  .top {
    left: 0;
    width: var(--t);
    height: var(--depth);
    top: calc((var(--h) - var(--depth)) / 2);
    transform: rotateX(90deg) translateZ(calc(var(--h) / 2));
    background:
      linear-gradient(90deg, var(--leather) 0 3px, transparent 3px calc(100% - 3px), var(--leather) calc(100% - 3px)),
      repeating-linear-gradient(90deg, #f3e6cc 0 2px, #dcc9a6 2px 3px);
  }

  .back {
    inset: 0;
    transform: rotateY(180deg) translateZ(calc(var(--depth) / 2));
    background: var(--leather);
  }

  /* ---------- The gap where the missing page belongs ---------- */
  .gap {
    position: relative;
    width: 96px;
    height: 200px;
    flex-shrink: 0;
    transform-style: preserve-3d;
  }

  .gap-card {
    position: absolute;
    left: 6px;
    width: 38px;
    bottom: 0;
    height: 150px;
    display: flex;
    align-items: center;
    justify-content: center;
    writing-mode: vertical-rl;
    text-orientation: upright;
    transform: translateZ(calc(var(--depth) / -2 + 4px));
    border: 2px dashed color-mix(in srgb, var(--accent-color) 70%, transparent);
    border-radius: 3px;
    font-family: 'Playfair Display', serif;
    font-weight: 700;
    font-size: 20px;
    letter-spacing: 0.05em;
    color: var(--accent-color);
    animation: flicker 3.5s ease-in-out infinite;
  }

  @keyframes flicker {
    0%, 100% { opacity: 0.9; }
    50% { opacity: 0.45; }
  }

  /* ---------- Coffee mug ---------- */
  .mug {
    position: relative;
    width: 60px;
    height: 72px;
    margin-left: 26px;
    flex-shrink: 0;
    transform-style: preserve-3d;
    transform: translateZ(20px);
  }

  .mug-face {
    position: absolute;
    top: 0;
    left: 50%;
    height: 72px;
    backface-visibility: hidden;
  }

  .mug-rim,
  .mug-coffee {
    position: absolute;
    left: 50%;
    border-radius: 50%;
  }

  .mug-rim {
    width: 60px;
    height: 60px;
    margin: -30px 0 0 -30px;
    top: 0;
    transform: rotateX(90deg);
    border: 3px solid #f3e6cc;
  }

  .mug-coffee {
    width: 54px;
    height: 54px;
    margin: -27px 0 0 -27px;
    top: 8px;
    transform: rotateX(90deg);
    background: radial-gradient(circle at 40% 40%, #8a5a3a, #4a2c1a 55%, #2e1a0e);
    box-shadow: inset 0 0 0 3px rgba(210, 160, 110, 0.35);
  }

  .mug-handle {
    position: absolute;
    top: 14px;
    right: -20px;
    width: 26px;
    height: 36px;
    border: 7px solid hsl(36 38% 74%);
    border-left: none;
    border-radius: 0 50% 50% 0 / 0 45% 45% 0;
  }

  .steam {
    position: absolute;
    bottom: 78px;
    left: 50%;
    width: 10px;
    height: 46px;
    border-radius: 50%;
    background: linear-gradient(to top, rgba(255, 255, 255, 0.55), transparent);
    filter: blur(5px);
    opacity: 0;
    animation: steam 3.2s ease-out infinite;
  }

  .s1 { margin-left: -16px; }
  .s2 { margin-left: -4px; animation-delay: 1s; }
  .s3 { margin-left: 8px; animation-delay: 2.1s; }

  :global([data-theme='light']) .steam {
    background: linear-gradient(to top, rgba(120, 90, 60, 0.35), transparent);
  }

  @keyframes steam {
    0% { transform: translateY(0) scaleX(1); opacity: 0; }
    20% { opacity: 1; }
    100% { transform: translateY(-50px) scaleX(1.8) rotate(8deg); opacity: 0; }
  }

  /* ---------- Wooden shelf plank ---------- */
  .plank {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 20px;
    height: var(--plank-t);
    transform-style: preserve-3d;
  }

  .plank > span {
    position: absolute;
    --wood:
      repeating-linear-gradient(90deg, rgba(0, 0, 0, 0.08) 0 2px, transparent 2px 23px, rgba(255, 255, 255, 0.05) 23px 25px, transparent 25px 41px),
      linear-gradient(#8b5e3c, #6b4a35);
  }

  .plank-front {
    inset: 0;
    transform: translateZ(calc(var(--plank-d) / 2));
    background: var(--wood);
    box-shadow: inset 0 -3px 0 rgba(0, 0, 0, 0.3);
  }

  .plank-top {
    left: 0;
    right: 0;
    height: var(--plank-d);
    top: calc((var(--plank-t) - var(--plank-d)) / 2);
    transform: rotateX(90deg) translateZ(calc(var(--plank-t) / 2));
    background:
      linear-gradient(rgba(0, 0, 0, 0.25), transparent 40%),
      var(--wood);
    filter: brightness(1.15);
  }

  .plank-end {
    top: 0;
    width: var(--plank-d);
    height: var(--plank-t);
    left: calc((var(--plank-w) - var(--plank-d)) / 2);
    background: #4f3322;
  }

  .plank-end.l {
    transform: rotateY(-90deg) translateZ(calc(var(--plank-w) / 2));
  }

  .plank-end.r {
    transform: rotateY(90deg) translateZ(calc(var(--plank-w) / 2));
  }

  .floor-shadow {
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: -6px;
    height: 30px;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(0, 0, 0, 0.35), transparent 70%);
    filter: blur(6px);
  }

  /* ---------- Copy ---------- */
  .copy {
    padding: 30px 0 90px;
    text-align: center;
  }

  .kicker {
    margin: 0 0 10px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent-color);
  }

  .copy h1 {
    font-size: 2.8rem;
    color: var(--heading-color);
    margin-bottom: 16px;
  }

  .lede {
    max-width: 560px;
    margin: 0 auto 10px;
    font-size: 1.1rem;
    font-style: italic;
    line-height: 1.7;
  }

  .hint {
    margin: 0 0 26px;
    font-size: 0.9rem;
    opacity: 0.75;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-bottom: 28px;
  }

  .btn {
    padding: 12px 24px;
    border: 1px solid var(--border-color);
    border-radius: 5px;
    background: var(--card-bg-color);
    color: var(--heading-color);
    font-family: 'Lora', serif;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }

  .btn:hover {
    transform: translateY(-2px);
    border-color: var(--accent-color);
  }

  .btn.primary {
    background: var(--heading-color);
    border-color: var(--heading-color);
    color: var(--bg-color);
  }

  .btn.primary:hover {
    background: var(--accent-color);
  }

  .quick {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 22px;
    font-size: 0.9rem;
  }

  .quick a {
    color: var(--text-color);
    text-decoration: underline;
    text-decoration-color: var(--border-color);
    text-underline-offset: 4px;
  }

  .quick a:hover {
    color: var(--accent-color);
    text-decoration-color: currentColor;
  }

  /* ---------- Small screens: shrink the whole scene ---------- */
  @media (max-width: 640px) {
    .stage {
      height: 230px;
      padding-top: 10px;
    }
    .scene {
      transform: scale(0.62);
      transform-origin: top center;
    }
    .copy h1 {
      font-size: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .world,
    .gap-card,
    .steam {
      animation: none !important;
    }
    .steam {
      opacity: 0.5;
    }
  }
</style>

<script>
  // Tilt the shelf toward the pointer so the books' depth shows
  const scene = document.getElementById('scene');
  const world = document.getElementById('world');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (scene && world && !reduce && window.matchMedia('(hover: hover)').matches) {
    let frame = 0;
    window.addEventListener('pointermove', (e) => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const x = e.clientX / window.innerWidth - 0.5; // -0.5..0.5
        const y = e.clientY / window.innerHeight - 0.5;
        world.classList.add('tracking');
        world.style.transform = `rotateX(${-12 - y * 16}deg) rotateY(${-15 + x * 40}deg)`;
      });
    });
    document.addEventListener('pointerleave', () => {
      world.classList.remove('tracking');
      world.style.transform = '';
    });
  }

  const random = document.getElementById('random-chapter');
  random?.addEventListener('click', () => {
    const urls: string[] = JSON.parse(random.dataset.urls ?? '[]');
    if (urls.length) window.location.href = urls[Math.floor(Math.random() * urls.length)];
  });
</script>
