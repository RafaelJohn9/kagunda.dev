---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getFolders } from '../folders';

const folders = await getFolders();
const posts = (await getCollection('blog', ({ data }) => !data.draft && !!data.category)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const latest = posts[0];

const CONTACTS = [
  { label: 'Email', value: 'john@kagunda.dev', href: 'mailto:john@kagunda.dev' },
  { label: 'GitHub', value: 'rafaeljohn9', href: 'https://github.com/rafaeljohn9' },
  { label: 'LinkedIn', value: 'John Kagunda', href: 'https://linkedin.com/in/john-kagunda-232961270/' },
  { label: 'X', value: '@JohnKagunda_12', href: 'https://x.com/JohnKagunda_12' },
];
---

<BaseLayout
  title="About"
  description="John Kagunda is a software engineer in Kenya writing about how systems actually work."
>
  <Header />

  <main>
    <section class="page-header">
      <div class="container">
        <p class="ex-libris">Ex libris</p>
        <h1>John Kagunda</h1>
        <p class="tagline">Software engineer in Kenya, thinking out loud one chapter at a time.</p>
      </div>
    </section>

    <section class="about">
      <div class="container narrow">
        <div class="prose">
          <p>
            I build software for the places it actually has to run. Lately that means desktop
            point-of-sale systems for Kenyan shops, built with Tauri and Rust to keep selling through
            power cuts and patchy networks, and growing from a single till to many branches.
          </p>
          <p>
            I'm curious about what sits underneath the tools we use every day, so a lot of what I write
            takes something familiar apart: what Git is really storing, how SQLite lays out its pages,
            how a GPT fits in a couple of hundred lines. Alongside that are notes on software
            architecture and on the books that change how I work.
          </p>
          <p>
            In 2025 my team and I won first place in the Business category at the JKUAT Hackathon with
            <a href="/blog/writings/optibiz-ai">OptiBiz AI</a>, a WhatsApp assistant that takes the
            admin work off small businesses.
          </p>
          <p>
            This site is my notebook: lessons learned, mistakes made, and the occasional breakthrough.
            Pour a cup and read along.
          </p>
        </div>

        <h2>On the shelf</h2>
        <ul class="shelf">
          {folders.map((folder, i) => (
            <li>
              <a href={`/series/${folder.id}`} style={`--leather: ${folder.color}`}>
                <span class="spine" aria-hidden="true"></span>
                <span class="vol">Vol. {String(i + 1).padStart(2, '0')}</span>
                <span class="name">{folder.title}</span>
                <span class="count">{folder.posts.length} {folder.posts.length === 1 ? 'chapter' : 'chapters'}</span>
              </a>
            </li>
          ))}
        </ul>
        <a class="archive-link" href="/blog">Browse all {posts.length} articles in the archive →</a>

        {latest && (
          <>
            <h2>Latest chapter</h2>
            <div class="latest">
              <ArticleCard post={latest} />
            </div>
          </>
        )}

        <h2>Say hello</h2>
        <dl class="contacts">
          {CONTACTS.map((c) => (
            <div>
              <dt>{c.label}</dt>
              <dd><a href={c.href}>{c.value}</a></dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page-header {
    padding: 80px 0 40px;
    text-align: center;
  }

  .ex-libris {
    margin: 0 0 10px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent-color);
  }

  .page-header h1 {
    font-size: 3.2rem;
    color: var(--heading-color);
    margin-bottom: 14px;
  }

  .tagline {
    font-style: italic;
    font-size: 1.15rem;
  }

  .about {
    padding-top: 20px;
  }

  .narrow {
    max-width: 760px;
  }

  .prose p {
    margin-bottom: 22px;
    font-size: 1.05rem;
    line-height: 1.85;
  }

  .prose p:first-child::first-letter {
    float: left;
    font-family: 'Playfair Display', serif;
    font-size: 3.6em;
    line-height: 0.85;
    margin: 0.05em 0.08em 0 0;
    color: var(--accent-color);
  }

  .prose a {
    color: var(--heading-color);
    text-underline-offset: 3px;
  }

  .about h2 {
    margin: 60px 0 22px;
    font-size: 1.6rem;
    color: var(--heading-color);
  }

  .shelf {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(220px, 100%), 1fr));
    gap: 14px;
  }

  .shelf a {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 16px 14px 30px;
    border: 1px solid var(--border-color);
    border-radius: 4px 8px 8px 4px;
    background: var(--card-bg-color);
    text-decoration: none;
    color: var(--text-color);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .shelf a:hover {
    transform: translateY(-3px);
    box-shadow: var(--card-hover-shadow);
  }

  .shelf .spine {
    position: absolute;
    inset: 0 auto 0 0;
    width: 14px;
    border-radius: 4px 0 0 4px;
    background: linear-gradient(90deg, color-mix(in srgb, var(--leather), #000 35%), var(--leather));
  }

  .shelf .vol {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-color);
  }

  .shelf .name {
    font-family: 'Playfair Display', serif;
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--heading-color);
  }

  .shelf .count {
    font-size: 0.8rem;
    font-style: italic;
    opacity: 0.75;
  }

  .archive-link {
    display: inline-block;
    margin-top: 18px;
    font-size: 0.9rem;
    font-weight: 700;
    font-style: italic;
    color: var(--heading-color);
    text-decoration: none;
  }

  .archive-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .contacts {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(160px, 100%), 1fr));
    gap: 14px 24px;
  }

  .contacts div {
    padding-bottom: 10px;
    border-bottom: 1px dashed var(--border-color);
  }

  .contacts dt {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-color);
  }

  .contacts dd {
    margin: 2px 0 0;
  }

  .contacts a {
    color: var(--heading-color);
    text-decoration: none;
    font-weight: 700;
  }

  .contacts a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 768px) {
    .page-header h1 {
      font-size: 2.3rem;
    }
  }
</style>
