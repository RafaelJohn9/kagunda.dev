---
import type { Folder } from '../folders';

export interface Props {
  folder: Folder;
  volume: number;
}

const { folder, volume } = Astro.props;
const MAX_LISTED = 4;
const listed = folder.posts.slice(0, MAX_LISTED);
const hidden = folder.posts.length - listed.length;
const count = folder.posts.length;
const chapters = `${count} ${count === 1 ? 'chapter' : 'chapters'}`;
const shortDate = (date: Date) =>
  date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---

<article class="book" style={`--leather: ${folder.color}`}>
  <span class="book-spine" aria-hidden="true"></span>

  <!-- Contents page, revealed when the cover swings open -->
  <div class="book-page">
    <p class="toc-head">Contents</p>
    <ol class="toc">
      {listed.map((post, i) => (
        <li style={`--i: ${i}`}>
          <a href={`/blog/${post.id}`}>
            <span class="idx">#{i + 1}</span>
            <span class="toc-title">{post.data.title}</span>
            <span class="leader" aria-hidden="true"></span>
            <time datetime={post.data.pubDate.toISOString()}>{shortDate(post.data.pubDate)}</time>
          </a>
        </li>
      ))}
    </ol>
    <a class="toc-all" href={`/series/${folder.id}`} style={`--i: ${listed.length}`}>
      {hidden > 0 ? `+${hidden} more chapters →` : 'Read the whole volume →'}
    </a>
  </div>

  <div class="book-cover">
    <div class="cover-front">
      <p class="vol">Vol. {String(volume).padStart(2, '0')} · {chapters}</p>
      <h3><a href={`/series/${folder.id}`}>{folder.title}</a></h3>
      <span class="ornament" aria-hidden="true"></span>
      <p class="cover-desc">{folder.description}</p>
      <span class="hint" aria-hidden="true"></span>
    </div>
    <div class="cover-inside" aria-hidden="true">
      <span class="bookplate">Ex libris<br /><strong>kagunda.dev</strong></span>
    </div>
  </div>
</article>

<style>
  .book {
    --spine-w: 18px;
    --gold: #e6c38a;
    --cream: #f3e6cc;
    position: relative;
    height: 380px;
    perspective: 2600px;
    transition: transform 0.4s ease;
  }

  .book:hover,
  .book:focus-within,
  .book.is-open {
    z-index: 5;
  }

  /* Spine: stays put while the cover swings on it */
  .book-spine {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--spine-w);
    border-radius: 4px 0 0 4px;
    background:
      linear-gradient(transparent 14%, var(--gold) 14%, var(--gold) calc(14% + 1px), transparent calc(14% + 1px),
        transparent 18%, var(--gold) 18%, var(--gold) calc(18% + 1px), transparent calc(18% + 1px),
        transparent 82%, var(--gold) 82%, var(--gold) calc(82% + 1px), transparent calc(82% + 1px),
        transparent 86%, var(--gold) 86%, var(--gold) calc(86% + 1px), transparent calc(86% + 1px)),
      linear-gradient(90deg,
        color-mix(in srgb, var(--leather), #000 45%),
        color-mix(in srgb, var(--leather), #fff 6%) 55%,
        color-mix(in srgb, var(--leather), #000 30%));
    opacity: 0.95;
    z-index: 3;
  }

  /* The page: a little smaller than the cover, like a real book */
  .book-page {
    position: absolute;
    inset: 6px 6px 6px var(--spine-w);
    padding: 18px 20px 14px 24px;
    display: flex;
    flex-direction: column;
    border-radius: 0 4px 4px 0;
    background:
      /* coffee ring left by a mug */
      radial-gradient(circle at 86% 90%,
        transparent 0 30px,
        rgba(139, 94, 60, 0.22) 31px 33px,
        rgba(139, 94, 60, 0.08) 34px 36px,
        transparent 37px),
      radial-gradient(circle at 82% 86%, rgba(139, 94, 60, 0.06), transparent 60px),
      /* gutter shadow near the spine */
      linear-gradient(90deg, rgba(60, 35, 15, 0.16), transparent 14%),
      var(--card-bg-color);
    box-shadow: inset 0 0 0 1px var(--border-color);
    z-index: 1;
  }

  .toc-head {
    margin: 0 0 10px;
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: 1.2rem;
    color: var(--heading-color);
    text-align: center;
  }

  .toc {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc li,
  .toc-all {
    opacity: 0;
    transform: translateX(10px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .toc a {
    display: grid;
    grid-template-columns: 2em minmax(0, max-content) minmax(1.2em, 1fr) auto;
    align-items: end;
    gap: 6px;
    padding: 6px 4px;
    text-decoration: none;
    color: var(--text-color);
    font-size: 0.85rem;
    line-height: 1.3;
    border-radius: 4px;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .toc a:hover,
  .toc a:focus-visible {
    background: color-mix(in srgb, var(--accent-color) 14%, transparent);
    color: var(--heading-color);
  }

  .idx {
    align-self: start;
    font-weight: 700;
    color: var(--accent-color);
    font-variant-numeric: tabular-nums;
  }

  .toc-title {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* dotted leader between chapter and date, as in a printed contents page */
  .leader {
    border-bottom: 2px dotted color-mix(in srgb, var(--text-color) 35%, transparent);
    margin-bottom: 0.3em;
  }

  .toc time {
    font-size: 0.75rem;
    font-style: italic;
    opacity: 0.7;
    white-space: nowrap;
  }

  .toc-all {
    margin-top: auto;
    align-self: flex-start;
    font-size: 0.8rem;
    font-weight: 700;
    font-style: italic;
    color: var(--heading-color);
    text-decoration: none;
  }

  .toc-all:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Cover: hinged on the spine */
  .book-cover {
    position: absolute;
    inset: 0 0 0 var(--spine-w);
    transform-origin: left center;
    transform-style: preserve-3d;
    transition: transform 0.9s cubic-bezier(0.3, 0.7, 0.2, 1);
    z-index: 2;
  }

  .cover-front,
  .cover-inside {
    position: absolute;
    inset: 0;
    border-radius: 0 6px 6px 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .cover-front {
    padding: 34px 30px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    color: var(--cream);
    background:
      radial-gradient(ellipse at 30% 20%, rgba(255, 255, 255, 0.1), transparent 60%),
      linear-gradient(135deg,
        color-mix(in srgb, var(--leather), #fff 8%),
        var(--leather) 45%,
        color-mix(in srgb, var(--leather), #000 28%));
    box-shadow:
      inset 4px 0 8px rgba(0, 0, 0, 0.35),
      0 6px 16px rgba(40, 22, 10, 0.25);
    transition: box-shadow 0.4s ease;
  }

  /* gold-tooled double frame */
  .cover-front::before,
  .cover-front::after {
    content: '';
    position: absolute;
    pointer-events: none;
    border: 1px solid color-mix(in srgb, var(--gold) 55%, transparent);
    border-radius: 3px;
  }

  .cover-front::before {
    inset: 12px;
  }

  .cover-front::after {
    inset: 17px;
    border-color: color-mix(in srgb, var(--gold) 25%, transparent);
  }

  .vol {
    margin: 0 0 18px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--gold) 85%, transparent);
  }

  .cover-front h3 {
    margin: 0;
    font-family: 'Playfair Display', serif;
    font-size: 1.6rem;
    line-height: 1.2;
  }

  .cover-front h3 a {
    position: relative;
    z-index: 1;
    color: var(--gold);
    text-decoration: none;
    text-shadow: 0 1px 0 rgba(0, 0, 0, 0.35);
  }

  .cover-front h3 a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .ornament {
    display: flex;
    align-items: center;
    width: 90px;
    height: 10px;
    margin: 16px 0;
    background: radial-gradient(circle, var(--gold) 0 3px, transparent 3.5px) center / 10px 10px no-repeat;
  }

  .ornament::before,
  .ornament::after {
    content: '';
    flex: 1;
    height: 1px;
    background: color-mix(in srgb, var(--gold) 60%, transparent);
  }

  .ornament::before {
    margin-right: 6px;
  }

  .ornament::after {
    margin-left: 6px;
  }

  .cover-desc {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.55;
    color: color-mix(in srgb, var(--cream) 88%, transparent);
  }

  .hint {
    margin-top: auto;
    font-size: 0.72rem;
    font-style: italic;
    color: color-mix(in srgb, var(--gold) 70%, transparent);
  }

  .hint::before {
    content: 'Hover to open';
  }

  @media (hover: none) {
    .hint::before {
      content: 'Tap to open';
    }
  }

  /* Inside of the cover: coffee-marbled endpaper with a bookplate */
  .cover-inside {
    transform: rotateY(180deg);
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(ellipse 60% 40% at 25% 30%, rgba(111, 78, 55, 0.55), transparent 70%),
      radial-gradient(ellipse 50% 35% at 75% 65%, rgba(166, 124, 82, 0.5), transparent 70%),
      radial-gradient(ellipse 40% 30% at 40% 85%, rgba(92, 64, 51, 0.5), transparent 70%),
      #d9c3a0;
  }

  .bookplate {
    padding: 14px 18px;
    border: 1px solid rgba(92, 64, 51, 0.6);
    background: #f3e6cc;
    color: #5c4033;
    font-size: 0.75rem;
    font-style: italic;
    text-align: center;
    line-height: 1.5;
  }

  /* Open: cover swings past 90° on its spine, contents follow in */
  .book:hover .book-cover,
  .book:focus-within .book-cover,
  .book.is-open .book-cover {
    transform: rotateY(-100deg);
    pointer-events: none;
  }

  .book:hover .toc li,
  .book:hover .toc-all,
  .book:focus-within .toc li,
  .book:focus-within .toc-all,
  .book.is-open .toc li,
  .book.is-open .toc-all {
    opacity: 1;
    transform: none;
    transition-duration: 0.35s;
    transition-delay: calc(0.3s + var(--i) * 0.07s);
  }

  @media (prefers-reduced-motion: reduce) {
    .book-cover,
    .toc li,
    .toc-all {
      transition-duration: 0s !important;
      transition-delay: 0s !important;
    }
  }
</style>

<script>
  // Touch screens can't hover: the first tap opens a book, taps on the open
  // contents page follow its links.
  if (window.matchMedia('(hover: none)').matches) {
    document.querySelectorAll<HTMLElement>('.book').forEach((book) => {
      book.addEventListener('click', (e) => {
        const link = (e.target as HTMLElement).closest('a');
        if (link && book.classList.contains('is-open')) return;
        if (link) e.preventDefault(); // cover title tapped while closed: open instead
        document.querySelectorAll('.book.is-open').forEach((b) => b !== book && b.classList.remove('is-open'));
        book.classList.toggle('is-open');
      });
    });
  }
</script>
