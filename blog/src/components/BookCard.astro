---
import type { Folder } from '../folders';

export interface Props {
  folder: Folder;
  volume: number;
}

const { folder, volume } = Astro.props;
// Four chapters fit on a contents page; longer volumes get more pages to flip through
const PER_PAGE = 4;
const pages = Array.from({ length: Math.ceil(folder.posts.length / PER_PAGE) }, (_, p) =>
  folder.posts.slice(p * PER_PAGE, (p + 1) * PER_PAGE),
);
const count = folder.posts.length;
const chapters = `${count} ${count === 1 ? 'chapter' : 'chapters'}`;
const shortDate = (date: Date) =>
  date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---

<article class="book" style={`--leather: ${folder.color}`}>
  <span class="book-spine" aria-hidden="true"></span>

  <!-- Contents pages, revealed when the cover swings open -->
  <div class="book-page">
    {pages.map((chapters, p) => (
      <section
        class="sheet"
        style={`--z: ${pages.length - p}; --stack: ${p}`}
        inert={p > 0}
        aria-label={`Contents, page ${p + 1} of ${pages.length}`}
      >
        <div class="sheet-front">
        <p class="toc-head">{p === 0 ? 'Contents' : 'Contents, continued'}</p>
        <ol class="toc">
          {chapters.map((post, i) => (
            <li style={`--i: ${i}`}>
              <a href={`/blog/${post.id}`}>
                <span class="idx">#{p * PER_PAGE + i + 1}</span>
                <span class="toc-title">{post.data.title}</span>
                <span class="leader" aria-hidden="true"></span>
                <time datetime={post.data.pubDate.toISOString()}>{shortDate(post.data.pubDate)}</time>
              </a>
            </li>
          ))}
        </ol>
        <span class="sheet-cast" aria-hidden="true"></span>
        </div>
        <div class="sheet-back" aria-hidden="true"></div>
      </section>
    ))}

    <!-- shadow the lifting cover casts on the page -->
    <span class="page-cast" aria-hidden="true"></span>

    <div class="page-foot" style={`--i: ${PER_PAGE}`}>
      {pages.length > 1 && (
        <div class="pager">
          <button class="flip prev" type="button" aria-label="Previous page" disabled>‹</button>
          <span class="page-num"><span class="cur">1</span> / {pages.length}</span>
          <button class="flip next" type="button" aria-label="Next page">›</button>
        </div>
      )}
      <a class="toc-all" href={`/series/${folder.id}`}>
        {pages.length > 1 ? 'All chapters →' : 'Read the whole volume →'}
      </a>
    </div>

    <button class="book-close" type="button" aria-label={`Close ${folder.title}`}>
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>

  <div class="book-cover">
    <div class="cover-front">
      <p class="vol">Vol. {String(volume).padStart(2, '0')} · {chapters}</p>
      <h3><a href={`/series/${folder.id}`}>{folder.title}</a></h3>
      <span class="ornament" aria-hidden="true"></span>
      <p class="cover-desc">{folder.description}</p>
      <span class="hint" aria-hidden="true"></span>
      <span class="cover-light" aria-hidden="true"></span>
    </div>
    <span class="cover-edge" aria-hidden="true"></span>
    <div class="cover-inside" aria-hidden="true">
      <span class="bookplate">Ex libris<br /><strong>kagunda.dev</strong></span>
    </div>
  </div>
</article>

<style>
  .book {
    --spine-w: 18px;
    --gold: #e6c38a;
    --cream: #f3e6cc;
    /* cover motion: a slow lift, a swing that overshoots and settles; closing
       falls shut and bounces lightly off the pages */
    --open-ease: cubic-bezier(0.34, 1.3, 0.5, 1);
    --close-ease: cubic-bezier(0.55, 0, 0.8, 0.4);
    position: relative;
    height: 380px;
    perspective: 2600px;
    transition: transform 0.4s ease;
  }

  @supports (transition-timing-function: linear(0, 1)) {
    .book {
      --open-ease: linear(0.000, 0.002, 0.007, 0.016, 0.028, 0.067, 0.203, 0.337, 0.465, 0.584, 0.690, 0.782, 0.861, 0.926, 0.979, 1.019, 1.049, 1.070, 1.083, 1.089, 1.091, 1.088, 1.083, 1.075, 1.067, 1.058, 1.048, 1.039, 1.031, 1.024, 1.017, 1.011, 1.007, 1.003, 1.000, 0.997, 0.996, 0.995, 0.994, 0.994, 0.994, 0.994, 0.995, 0.995, 0.996, 0.996, 0.997, 0.998, 0.998);
      --close-ease: linear(0.000, 0.000, 0.001, 0.003, 0.007, 0.011, 0.016, 0.022, 0.030, 0.039, 0.049, 0.061, 0.073, 0.087, 0.103, 0.120, 0.138, 0.158, 0.179, 0.201, 0.225, 0.251, 0.278, 0.307, 0.337, 0.368, 0.402, 0.436, 0.473, 0.511, 0.550, 0.591, 0.634, 0.679, 0.725, 0.772, 0.822, 0.873, 0.926, 0.980, 0.988, 0.972, 0.959, 0.952, 0.950, 0.956, 0.967, 0.982, 1.000);
    }
  }

  .book.is-open {
    z-index: 5;
  }

  @media (hover: hover) {
    .book:is(:hover, :focus-within) {
      z-index: 5;
    }
  }

  /* Spine: stays put while the cover swings on it */
  .book-spine {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--spine-w);
    border-radius: 4px 0 0 4px;
    background:
      linear-gradient(transparent 14%, var(--gold) 14%, var(--gold) calc(14% + 1px), transparent calc(14% + 1px),
        transparent 18%, var(--gold) 18%, var(--gold) calc(18% + 1px), transparent calc(18% + 1px),
        transparent 82%, var(--gold) 82%, var(--gold) calc(82% + 1px), transparent calc(82% + 1px),
        transparent 86%, var(--gold) 86%, var(--gold) calc(86% + 1px), transparent calc(86% + 1px)),
      linear-gradient(90deg,
        color-mix(in srgb, var(--leather), #000 45%),
        color-mix(in srgb, var(--leather), #fff 6%) 55%,
        color-mix(in srgb, var(--leather), #000 30%));
    opacity: 0.95;
    z-index: 3;
  }

  /* The page: a little smaller than the cover, like a real book */
  .book-page {
    position: absolute;
    inset: 6px 6px 6px var(--spine-w);
    perspective: 1400px;
    z-index: 1;
    /* drop under the cover at once when closing */
    transition: z-index 0s;
  }

  /* Each sheet is a page that turns on the spine: a front, a blank back, and
     two shading layers the page-turn animation plays with */
  .sheet {
    position: absolute;
    inset: 0;
    z-index: var(--z);
    transform-origin: left center;
    transform-style: preserve-3d;
  }

  /* turned pages lie on the open cover, fanned a little so the stack shows */
  .sheet.turned {
    transform: rotateY(calc(-97deg + var(--stack) * 1.3deg));
  }

  .sheet-front,
  .sheet-back {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .sheet-back {
    transform: rotateY(180deg);
    border-radius: 4px 0 0 4px;
    background:
      linear-gradient(90deg, rgba(60, 35, 15, 0.16), transparent 14%),
      /* faint lines of ink showing through from the other side */
      repeating-linear-gradient(transparent 0 26px, rgba(92, 64, 51, 0.025) 26px 29px),
      var(--card-bg-color);
    box-shadow: inset 0 0 0 1px var(--border-color);
  }

  .sheet-cast,
  .page-cast {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
  }

  /* shadow thrown by a page turning above this one */
  .sheet-cast {
    background: linear-gradient(90deg, rgba(40, 22, 10, 0.5), rgba(40, 22, 10, 0.14) 45%, transparent 80%);
  }

  /* shadow thrown by the cover: heavy while it's shut, gone once it's open */
  .page-cast {
    z-index: 45;
    opacity: 1;
    background: linear-gradient(90deg, rgba(30, 15, 5, 0.55), rgba(30, 15, 5, 0.3) 55%, rgba(30, 15, 5, 0.15));
    transition: opacity 0.3s ease-in;
  }

  /* The flexible page used while a sheet turns: a chain of thin strips, each
     hinged to the last, so small angles add up to a curve. Built in JS, so
     these selectors are global. */
  .book-page :global(.flex-page) {
    position: absolute;
    inset: 0;
    z-index: 150;
    pointer-events: none;
    transform-style: preserve-3d;
  }

  .book-page :global(.flex-strip) {
    position: absolute;
    top: 0;
    transform-origin: left center;
    transform-style: preserve-3d;
  }

  .book-page :global(.flex-face) {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: calc(100% + 1px); /* a hair of overlap hides the seams */
    overflow: hidden;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .book-page :global(.flex-back) {
    transform: rotateY(180deg);
  }

  .book-page :global(.flex-shade) {
    position: absolute;
    inset: 0;
  }

  .sheet-front {
    padding: 18px 20px 58px 24px;
    border-radius: 0 4px 4px 0;
    background:
      /* coffee ring left by a mug */
      radial-gradient(circle at 86% 90%,
        transparent 0 30px,
        rgba(139, 94, 60, 0.22) 31px 33px,
        rgba(139, 94, 60, 0.08) 34px 36px,
        transparent 37px),
      radial-gradient(circle at 82% 86%, rgba(139, 94, 60, 0.06), transparent 60px),
      /* gutter shadow near the spine */
      linear-gradient(90deg, rgba(60, 35, 15, 0.16), transparent 14%),
      var(--card-bg-color);
    box-shadow: inset 0 0 0 1px var(--border-color);
  }

  .toc-head {
    margin: 0 0 10px;
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: 1.2rem;
    color: var(--heading-color);
    text-align: center;
  }

  .toc {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc li,
  .page-foot {
    opacity: 0;
    transform: translateX(10px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .toc a {
    display: grid;
    grid-template-columns: 2em minmax(0, max-content) minmax(1.2em, 1fr) auto;
    align-items: end;
    gap: 6px;
    padding: 6px 4px;
    text-decoration: none;
    color: var(--text-color);
    font-size: 0.85rem;
    line-height: 1.3;
    border-radius: 4px;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .toc a:hover,
  .toc a:focus-visible {
    background: color-mix(in srgb, var(--accent-color) 14%, transparent);
    color: var(--heading-color);
  }

  .idx {
    align-self: start;
    font-weight: 700;
    color: var(--accent-color);
    font-variant-numeric: tabular-nums;
  }

  .toc-title {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* dotted leader between chapter and date, as in a printed contents page */
  .leader {
    border-bottom: 2px dotted color-mix(in srgb, var(--text-color) 35%, transparent);
    margin-bottom: 0.3em;
  }

  .toc time {
    font-size: 0.75rem;
    font-style: italic;
    opacity: 0.7;
    white-space: nowrap;
  }

  .page-foot {
    position: absolute;
    left: 24px;
    right: 20px;
    bottom: 12px;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .pager {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .flip {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    padding: 0 0 2px;
    border: 1px solid var(--border-color);
    border-radius: 50%;
    background: var(--bg-color);
    color: var(--heading-color);
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .flip:hover:not(:disabled) {
    border-color: var(--accent-color);
    background: color-mix(in srgb, var(--accent-color) 12%, var(--bg-color));
  }

  .flip:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .page-num {
    min-width: 3.2em;
    text-align: center;
    font-size: 0.75rem;
    font-style: italic;
    font-variant-numeric: tabular-nums;
    opacity: 0.8;
  }

  /* Close button: only on touch screens, where there's no hover to leave */
  .book-close {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 60;
    width: 36px;
    height: 36px;
    display: none;
    place-items: center;
    border: 1px solid var(--border-color);
    border-radius: 50%;
    background: var(--bg-color);
    color: var(--heading-color);
    cursor: pointer;
  }

  @media (hover: none) {
    .book.is-open .book-close {
      display: grid;
    }
    .flip {
      width: 38px;
      height: 38px;
    }
  }

  .toc-all {
    font-size: 0.8rem;
    font-weight: 700;
    font-style: italic;
    color: var(--heading-color);
    text-decoration: none;
  }

  .toc-all:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Cover: hinged on the spine */
  .book-cover {
    position: absolute;
    inset: 0 0 0 var(--spine-w);
    transform-origin: left center;
    transform-style: preserve-3d;
    transition: transform 0.75s var(--close-ease);
    z-index: 2;
  }

  /* the cover has a board edge you can see while it swings */
  .cover-edge {
    position: absolute;
    top: 1px;
    bottom: 1px;
    left: 100%;
    width: 4px;
    transform-origin: left center;
    transform: rotateY(90deg);
    background: linear-gradient(color-mix(in srgb, var(--leather), #000 20%), color-mix(in srgb, var(--leather), #000 45%));
  }

  /* the front darkens as it turns away from the light */
  .cover-light {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.05), rgba(0, 0, 0, 0.5));
    opacity: 0;
    transition: opacity 0.7s ease-out;
  }

  .cover-front,
  .cover-inside {
    position: absolute;
    inset: 0;
    border-radius: 0 6px 6px 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .cover-front {
    padding: 34px 30px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    color: var(--cream);
    background:
      radial-gradient(ellipse at 30% 20%, rgba(255, 255, 255, 0.1), transparent 60%),
      linear-gradient(135deg,
        color-mix(in srgb, var(--leather), #fff 8%),
        var(--leather) 45%,
        color-mix(in srgb, var(--leather), #000 28%));
    box-shadow:
      inset 4px 0 8px rgba(0, 0, 0, 0.35),
      0 6px 16px rgba(40, 22, 10, 0.25);
    transition: box-shadow 0.4s ease;
  }

  /* gold-tooled double frame */
  .cover-front::before,
  .cover-front::after {
    content: '';
    position: absolute;
    pointer-events: none;
    border: 1px solid color-mix(in srgb, var(--gold) 55%, transparent);
    border-radius: 3px;
  }

  .cover-front::before {
    inset: 12px;
  }

  .cover-front::after {
    inset: 17px;
    border-color: color-mix(in srgb, var(--gold) 25%, transparent);
  }

  .vol {
    margin: 0 0 18px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--gold) 85%, transparent);
  }

  .cover-front h3 {
    margin: 0;
    font-family: 'Playfair Display', serif;
    font-size: 1.6rem;
    line-height: 1.2;
  }

  .cover-front h3 a {
    position: relative;
    z-index: 1;
    color: var(--gold);
    text-decoration: none;
    text-shadow: 0 1px 0 rgba(0, 0, 0, 0.35);
  }

  .cover-front h3 a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .ornament {
    display: flex;
    align-items: center;
    width: 90px;
    height: 10px;
    margin: 16px 0;
    background: radial-gradient(circle, var(--gold) 0 3px, transparent 3.5px) center / 10px 10px no-repeat;
  }

  .ornament::before,
  .ornament::after {
    content: '';
    flex: 1;
    height: 1px;
    background: color-mix(in srgb, var(--gold) 60%, transparent);
  }

  .ornament::before {
    margin-right: 6px;
  }

  .ornament::after {
    margin-left: 6px;
  }

  .cover-desc {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.55;
    color: color-mix(in srgb, var(--cream) 88%, transparent);
  }

  .hint {
    margin-top: auto;
    font-size: 0.72rem;
    font-style: italic;
    color: color-mix(in srgb, var(--gold) 70%, transparent);
  }

  .hint::before {
    content: 'Hover to open';
  }

  @media (hover: none) {
    .hint::before {
      content: 'Tap to open';
    }
  }

  /* Inside of the cover: coffee-marbled endpaper with a bookplate */
  .cover-inside {
    transform: rotateY(180deg) translateZ(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(ellipse 60% 40% at 25% 30%, rgba(111, 78, 55, 0.55), transparent 70%),
      radial-gradient(ellipse 50% 35% at 75% 65%, rgba(166, 124, 82, 0.5), transparent 70%),
      radial-gradient(ellipse 40% 30% at 40% 85%, rgba(92, 64, 51, 0.5), transparent 70%),
      #d9c3a0;
  }

  .bookplate {
    padding: 14px 18px;
    border: 1px solid rgba(92, 64, 51, 0.6);
    background: #f3e6cc;
    color: #5c4033;
    font-size: 0.75rem;
    font-style: italic;
    text-align: center;
    line-height: 1.5;
  }

  /* Open: cover swings past 90° on its spine, contents follow in.
     Touch screens only use .is-open: a tapped element keeps :hover until the
     next tap elsewhere, which would stop the close button from closing it. */
  .book.is-open .book-cover {
    transform: rotateY(-100deg);
    pointer-events: none;
    transition: transform 1.05s var(--open-ease);
  }

  .book.is-open .cover-light {
    opacity: 1;
    transition: opacity 0.55s ease-in;
  }

  .book.is-open .page-cast {
    opacity: 0;
    transition: opacity 0.9s ease-out 0.12s;
  }

  /* once the cover is past upright, lift the pages above it so turned pages
     can rest on the inside of the cover */
  .book.is-open .book-page {
    z-index: 3;
    transition: z-index 0s linear 0.45s;
  }

  .book.is-open :is(.toc li, .page-foot) {
    opacity: 1;
    transform: none;
    transition-duration: 0.35s;
    transition-delay: calc(0.3s + var(--i) * 0.07s);
  }

  @media (hover: hover) {
    .book:is(:hover, :focus-within) .book-cover {
      transform: rotateY(-100deg);
      pointer-events: none;
      transition: transform 1.05s var(--open-ease);
    }

    .book:is(:hover, :focus-within) .cover-light {
      opacity: 1;
      transition: opacity 0.55s ease-in;
    }

    .book:is(:hover, :focus-within) .page-cast {
      opacity: 0;
      transition: opacity 0.9s ease-out 0.12s;
    }

    .book:is(:hover, :focus-within) .book-page {
      z-index: 3;
      transition: z-index 0s linear 0.45s;
    }

    .book:is(:hover, :focus-within) :is(.toc li, .page-foot) {
      opacity: 1;
      transform: none;
      transition-duration: 0.35s;
      transition-delay: calc(0.3s + var(--i) * 0.07s);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .book-cover,
    .book-page,
    .cover-light,
    .page-cast,
    .toc li,
    .page-foot {
      transition-duration: 0s !important;
      transition-delay: 0s !important;
    }
  }
</style>

<script>
  const books = [...document.querySelectorAll<HTMLElement>('.book')];
  const resets = new Map<HTMLElement, () => void>();

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const TURN_MS = 900;

  // One page turn, done by a flexible stand-in: the real sheet is hidden while
  // a copy of it, cut into hinged strips, curls over. The outer edge leads as
  // the page lifts, then trails as it flops over, and lands flat.
  const STRIPS = 10;
  const BEND = 42; // degrees of curl at the outer edge, at its strongest
  const easeInOut = (t: number) => 0.5 - Math.cos(Math.PI * t) / 2;
  // < 0: edge leads (the corner lifts first), > 0: edge trails (the page
  // flops over), 0 at both ends so it starts and lands flat
  const curl = (t: number) =>
    t < 0.3 ? -0.9 * Math.sin((Math.PI * t) / 0.3) : Math.sin((Math.PI * (t - 0.3)) / 0.7);

  const flexTurn = (
    book: HTMLElement,
    sheet: HTMLElement,
    stack: number,
    forward: boolean,
    ms: number,
    delay: number,
  ) =>
    new Promise<void>((done) => {
      const pageEl = book.querySelector<HTMLElement>('.book-page');
      const front = sheet.querySelector<HTMLElement>('.sheet-front');
      const back = sheet.querySelector<HTMLElement>('.sheet-back');
      if (reduceMotion || document.hidden || !pageEl || !front || !back) return done();

      const W = sheet.offsetWidth;
      const H = sheet.offsetHeight;
      const sw = W / STRIPS;
      const root = document.createElement('div');
      root.className = 'flex-page';
      root.setAttribute('aria-hidden', 'true');
      root.inert = true;

      const strips: HTMLElement[] = [];
      const shades: [HTMLElement, HTMLElement][] = [];
      let parent: HTMLElement = root;
      for (let k = 0; k < STRIPS; k++) {
        const strip = document.createElement('div');
        strip.className = 'flex-strip';
        strip.style.cssText = `width:${sw}px;height:${H}px;left:${k === 0 ? 0 : sw}px`;

        // this strip's slice of the page front, and the mirrored slice of its back
        const face = document.createElement('div');
        face.className = 'flex-face';
        const frontCopy = front.cloneNode(true) as HTMLElement;
        frontCopy.style.cssText = `inset:auto;top:0;left:${-k * sw}px;width:${W}px;height:${H}px`;
        const faceShade = document.createElement('div');
        faceShade.className = 'flex-shade';
        face.append(frontCopy, faceShade);

        const rear = document.createElement('div');
        rear.className = 'flex-face flex-back';
        const backCopy = back.cloneNode(true) as HTMLElement;
        backCopy.style.cssText = `inset:auto;top:0;left:${-(STRIPS - 1 - k) * sw}px;width:${W}px;height:${H}px;transform:none`;
        const rearShade = document.createElement('div');
        rearShade.className = 'flex-shade';
        rear.append(backCopy, rearShade);

        strip.append(face, rear);
        parent.appendChild(strip);
        parent = strip;
        strips.push(strip);
        shades.push([faceShade, rearShade]);
      }

      const rest = -97 + stack * 1.3;
      const pose = (q: number) => {
        const base = rest * (forward ? easeInOut(q) : 1 - easeInOut(q));
        // curl opposes the direction of travel when trailing, so flip it going back
        const bend = BEND * curl(q) * (forward ? 1 : -1);
        // strip 0 hinges on the spine; each later strip adds a little more curl
        const own = strips.map((_, k) => (k === 0 ? base : (bend * 2 * k) / (STRIPS * (STRIPS - 1))));
        const facing: number[] = [];
        own.reduce((sum, a, k) => (facing[k] = sum + a), 0);
        const dark = (deg: number) => Math.abs(Math.sin((deg * Math.PI) / 180));
        strips.forEach((strip, k) => {
          strip.style.transform = `rotateY(${own[k]}deg)`;
          // shade each strip from its neighbours' angles so the light rolls
          // smoothly along the curve instead of stepping strip by strip
          const a0 = dark((facing[Math.max(0, k - 1)] + facing[k]) / 2);
          const a1 = dark((facing[k] + facing[Math.min(STRIPS - 1, k + 1)]) / 2);
          const tint = (a: number, f: number) => `rgba(40, 22, 10, ${(a * f).toFixed(3)})`;
          shades[k][0].style.background = `linear-gradient(90deg, ${tint(a0, 0.5)}, ${tint(a1, 0.5)})`;
          shades[k][1].style.background = `linear-gradient(270deg, ${tint(a0, 0.3)}, ${tint(a1, 0.3)})`;
        });
      };

      pose(0);
      pageEl.appendChild(root);
      sheet.style.visibility = 'hidden';
      const start = performance.now() + delay;
      const frame = (now: number) => {
        const q = Math.min(1, Math.max(0, (now - start) / ms));
        pose(q);
        if (q < 1) requestAnimationFrame(frame);
        else {
          sheet.style.visibility = '';
          root.remove();
          done();
        }
      };
      requestAnimationFrame(frame);
    });

  const castShadow = (sheet: HTMLElement | undefined, from: number, to: number, ms: number, delay: number) =>
    sheet?.querySelector('.sheet-cast')?.animate([{ opacity: from }, { opacity: to }], {
      duration: ms,
      delay,
      easing: 'ease-out',
      fill: 'backwards',
    });

  // Page flipping: buttons everywhere, swipe on touch screens
  books.forEach((book) => {
    const sheets = [...book.querySelectorAll<HTMLElement>('.sheet')];
    const prev = book.querySelector<HTMLButtonElement>('.flip.prev');
    const next = book.querySelector<HTMLButtonElement>('.flip.next');
    const cur = book.querySelector('.page-num .cur');
    let page = 0;

    const go = (n: number, ms = TURN_MS) => {
      n = Math.max(0, Math.min(sheets.length - 1, n));
      if (n === page) return;
      const forward = n > page;
      // the sheets that actually turn, in the order they turn
      const turning = forward ? sheets.slice(page, n) : sheets.slice(n, page).reverse();
      const from = page;
      page = n;

      sheets.forEach((sheet, i) => {
        sheet.classList.toggle('turned', i < page);
        sheet.inert = i !== page;
      });

      if (!reduceMotion) {
        turning.forEach((sheet, k) => {
          const i = sheets.indexOf(sheet);
          const delay = k * 110; // several pages at once fan out one after another
          // a page coming back must pass over the current one; a page going
          // forward must end up on top of the pages already turned
          if (!forward) sheet.style.zIndex = String(200 + i);
          flexTurn(book, sheet, i, forward, ms, delay).then(() => {
            sheet.style.zIndex = forward ? String(100 + i) : '';
          });
        });
        if (forward) castShadow(sheets[n], 0.5, 0, ms * 0.8, (turning.length - 1) * 110);
        else castShadow(sheets[from], 0, 0.5, ms, 0);
      } else {
        sheets.forEach((sheet, i) => (sheet.style.zIndex = i < page ? String(100 + i) : ''));
      }

      if (prev) prev.disabled = page === 0;
      if (next) next.disabled = page === sheets.length - 1;
      if (cur) cur.textContent = String(page + 1);
    };
    // closing the book brings any turned pages back with the cover
    resets.set(book, () => go(0, 550));

    prev?.addEventListener('click', () => go(page - 1));
    next?.addEventListener('click', () => go(page + 1));

    if (sheets.length > 1) {
      const pageEl = book.querySelector<HTMLElement>('.book-page');
      let x0 = 0;
      let y0 = 0;
      pageEl?.addEventListener('touchstart', (e) => {
        x0 = e.touches[0].clientX;
        y0 = e.touches[0].clientY;
      }, { passive: true });
      pageEl?.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - x0;
        const dy = e.changedTouches[0].clientY - y0;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) go(page + (dx < 0 ? 1 : -1));
      });
    }

    // With a mouse, the pages close with the cover when the pointer leaves
    let leaveTimer: number | undefined;
    book.addEventListener('mouseleave', () => {
      if (book.contains(document.activeElement)) (document.activeElement as HTMLElement).blur();
      leaveTimer = window.setTimeout(() => go(0, 550), 150);
    });
    book.addEventListener('mouseenter', () => clearTimeout(leaveTimer));
  });

  const closeAll = (except?: HTMLElement) => {
    books.forEach((b) => {
      if (b !== except && b.classList.contains('is-open')) {
        b.classList.remove('is-open');
        resets.get(b)?.();
      }
    });
  };

  // Touch screens can't hover: tap a book to open it; close it with the ×,
  // by tapping outside it, or with Escape
  if (window.matchMedia('(hover: none)').matches) {
    books.forEach((book) => {
      book.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('.book-close')) {
          closeAll();
          return;
        }
        if (target.closest('button')) return; // page flips
        if (book.classList.contains('is-open')) return; // links on the open page work as normal
        e.preventDefault(); // a tap on the closed cover opens it instead of following the title link
        closeAll(book);
        book.classList.add('is-open');
      });
    });
    document.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('.book')) closeAll();
    });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAll();
  });
</script>
