---
import type { Folder } from '../folders';

export interface Props {
  folder: Folder;
  volume: number;
}

const { folder, volume } = Astro.props;
// Four chapters fit on a contents page; longer volumes get more pages to flip through
const PER_PAGE = 4;
const pages = Array.from({ length: Math.ceil(folder.posts.length / PER_PAGE) }, (_, p) =>
  folder.posts.slice(p * PER_PAGE, (p + 1) * PER_PAGE),
);
const count = folder.posts.length;
const chapters = `${count} ${count === 1 ? 'chapter' : 'chapters'}`;
const shortDate = (date: Date) =>
  date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---

<article class="book" style={`--leather: ${folder.color}`}>
  <span class="book-spine" aria-hidden="true"></span>

  <!-- Contents pages, revealed when the cover swings open -->
  <div class="book-page">
    {pages.map((chapters, p) => (
      <section
        class="sheet"
        style={`--z: ${pages.length - p}`}
        inert={p > 0}
        aria-label={`Contents, page ${p + 1} of ${pages.length}`}
      >
        <p class="toc-head">{p === 0 ? 'Contents' : 'Contents, continued'}</p>
        <ol class="toc">
          {chapters.map((post, i) => (
            <li style={`--i: ${i}`}>
              <a href={`/blog/${post.id}`}>
                <span class="idx">#{p * PER_PAGE + i + 1}</span>
                <span class="toc-title">{post.data.title}</span>
                <span class="leader" aria-hidden="true"></span>
                <time datetime={post.data.pubDate.toISOString()}>{shortDate(post.data.pubDate)}</time>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))}

    <div class="page-foot" style={`--i: ${PER_PAGE}`}>
      {pages.length > 1 && (
        <div class="pager">
          <button class="flip prev" type="button" aria-label="Previous page" disabled>‹</button>
          <span class="page-num"><span class="cur">1</span> / {pages.length}</span>
          <button class="flip next" type="button" aria-label="Next page">›</button>
        </div>
      )}
      <a class="toc-all" href={`/series/${folder.id}`}>
        {pages.length > 1 ? 'All chapters →' : 'Read the whole volume →'}
      </a>
    </div>

    <button class="book-close" type="button" aria-label={`Close ${folder.title}`}>
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>

  <div class="book-cover">
    <div class="cover-front">
      <p class="vol">Vol. {String(volume).padStart(2, '0')} · {chapters}</p>
      <h3><a href={`/series/${folder.id}`}>{folder.title}</a></h3>
      <span class="ornament" aria-hidden="true"></span>
      <p class="cover-desc">{folder.description}</p>
      <span class="hint" aria-hidden="true"></span>
    </div>
    <div class="cover-inside" aria-hidden="true">
      <span class="bookplate">Ex libris<br /><strong>kagunda.dev</strong></span>
    </div>
  </div>
</article>

<style>
  .book {
    --spine-w: 18px;
    --gold: #e6c38a;
    --cream: #f3e6cc;
    position: relative;
    height: 380px;
    perspective: 2600px;
    transition: transform 0.4s ease;
  }

  .book.is-open {
    z-index: 5;
  }

  @media (hover: hover) {
    .book:is(:hover, :focus-within) {
      z-index: 5;
    }
  }

  /* Spine: stays put while the cover swings on it */
  .book-spine {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--spine-w);
    border-radius: 4px 0 0 4px;
    background:
      linear-gradient(transparent 14%, var(--gold) 14%, var(--gold) calc(14% + 1px), transparent calc(14% + 1px),
        transparent 18%, var(--gold) 18%, var(--gold) calc(18% + 1px), transparent calc(18% + 1px),
        transparent 82%, var(--gold) 82%, var(--gold) calc(82% + 1px), transparent calc(82% + 1px),
        transparent 86%, var(--gold) 86%, var(--gold) calc(86% + 1px), transparent calc(86% + 1px)),
      linear-gradient(90deg,
        color-mix(in srgb, var(--leather), #000 45%),
        color-mix(in srgb, var(--leather), #fff 6%) 55%,
        color-mix(in srgb, var(--leather), #000 30%));
    opacity: 0.95;
    z-index: 3;
  }

  /* The page: a little smaller than the cover, like a real book */
  .book-page {
    position: absolute;
    inset: 6px 6px 6px var(--spine-w);
    perspective: 1400px;
    z-index: 1;
  }

  /* Each sheet is a page that turns on the spine */
  .sheet {
    position: absolute;
    inset: 0;
    padding: 18px 20px 58px 24px;
    border-radius: 0 4px 4px 0;
    z-index: var(--z);
    transform-origin: left center;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transition: transform 0.7s cubic-bezier(0.45, 0.05, 0.2, 1);
    background:
      /* coffee ring left by a mug */
      radial-gradient(circle at 86% 90%,
        transparent 0 30px,
        rgba(139, 94, 60, 0.22) 31px 33px,
        rgba(139, 94, 60, 0.08) 34px 36px,
        transparent 37px),
      radial-gradient(circle at 82% 86%, rgba(139, 94, 60, 0.06), transparent 60px),
      /* gutter shadow near the spine */
      linear-gradient(90deg, rgba(60, 35, 15, 0.16), transparent 14%),
      var(--card-bg-color);
    box-shadow: inset 0 0 0 1px var(--border-color);
  }

  .sheet.turned {
    transform: rotateY(-180deg);
  }

  .toc-head {
    margin: 0 0 10px;
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: 1.2rem;
    color: var(--heading-color);
    text-align: center;
  }

  .toc {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc li,
  .page-foot {
    opacity: 0;
    transform: translateX(10px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .toc a {
    display: grid;
    grid-template-columns: 2em minmax(0, max-content) minmax(1.2em, 1fr) auto;
    align-items: end;
    gap: 6px;
    padding: 6px 4px;
    text-decoration: none;
    color: var(--text-color);
    font-size: 0.85rem;
    line-height: 1.3;
    border-radius: 4px;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .toc a:hover,
  .toc a:focus-visible {
    background: color-mix(in srgb, var(--accent-color) 14%, transparent);
    color: var(--heading-color);
  }

  .idx {
    align-self: start;
    font-weight: 700;
    color: var(--accent-color);
    font-variant-numeric: tabular-nums;
  }

  .toc-title {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* dotted leader between chapter and date, as in a printed contents page */
  .leader {
    border-bottom: 2px dotted color-mix(in srgb, var(--text-color) 35%, transparent);
    margin-bottom: 0.3em;
  }

  .toc time {
    font-size: 0.75rem;
    font-style: italic;
    opacity: 0.7;
    white-space: nowrap;
  }

  .page-foot {
    position: absolute;
    left: 24px;
    right: 20px;
    bottom: 12px;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .pager {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .flip {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    padding: 0 0 2px;
    border: 1px solid var(--border-color);
    border-radius: 50%;
    background: var(--bg-color);
    color: var(--heading-color);
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .flip:hover:not(:disabled) {
    border-color: var(--accent-color);
    background: color-mix(in srgb, var(--accent-color) 12%, var(--bg-color));
  }

  .flip:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .page-num {
    min-width: 3.2em;
    text-align: center;
    font-size: 0.75rem;
    font-style: italic;
    font-variant-numeric: tabular-nums;
    opacity: 0.8;
  }

  /* Close button: only on touch screens, where there's no hover to leave */
  .book-close {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 60;
    width: 36px;
    height: 36px;
    display: none;
    place-items: center;
    border: 1px solid var(--border-color);
    border-radius: 50%;
    background: var(--bg-color);
    color: var(--heading-color);
    cursor: pointer;
  }

  @media (hover: none) {
    .book.is-open .book-close {
      display: grid;
    }
    .flip {
      width: 38px;
      height: 38px;
    }
  }

  .toc-all {
    font-size: 0.8rem;
    font-weight: 700;
    font-style: italic;
    color: var(--heading-color);
    text-decoration: none;
  }

  .toc-all:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Cover: hinged on the spine */
  .book-cover {
    position: absolute;
    inset: 0 0 0 var(--spine-w);
    transform-origin: left center;
    transform-style: preserve-3d;
    transition: transform 0.9s cubic-bezier(0.3, 0.7, 0.2, 1);
    z-index: 2;
  }

  .cover-front,
  .cover-inside {
    position: absolute;
    inset: 0;
    border-radius: 0 6px 6px 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .cover-front {
    padding: 34px 30px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    color: var(--cream);
    background:
      radial-gradient(ellipse at 30% 20%, rgba(255, 255, 255, 0.1), transparent 60%),
      linear-gradient(135deg,
        color-mix(in srgb, var(--leather), #fff 8%),
        var(--leather) 45%,
        color-mix(in srgb, var(--leather), #000 28%));
    box-shadow:
      inset 4px 0 8px rgba(0, 0, 0, 0.35),
      0 6px 16px rgba(40, 22, 10, 0.25);
    transition: box-shadow 0.4s ease;
  }

  /* gold-tooled double frame */
  .cover-front::before,
  .cover-front::after {
    content: '';
    position: absolute;
    pointer-events: none;
    border: 1px solid color-mix(in srgb, var(--gold) 55%, transparent);
    border-radius: 3px;
  }

  .cover-front::before {
    inset: 12px;
  }

  .cover-front::after {
    inset: 17px;
    border-color: color-mix(in srgb, var(--gold) 25%, transparent);
  }

  .vol {
    margin: 0 0 18px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--gold) 85%, transparent);
  }

  .cover-front h3 {
    margin: 0;
    font-family: 'Playfair Display', serif;
    font-size: 1.6rem;
    line-height: 1.2;
  }

  .cover-front h3 a {
    position: relative;
    z-index: 1;
    color: var(--gold);
    text-decoration: none;
    text-shadow: 0 1px 0 rgba(0, 0, 0, 0.35);
  }

  .cover-front h3 a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .ornament {
    display: flex;
    align-items: center;
    width: 90px;
    height: 10px;
    margin: 16px 0;
    background: radial-gradient(circle, var(--gold) 0 3px, transparent 3.5px) center / 10px 10px no-repeat;
  }

  .ornament::before,
  .ornament::after {
    content: '';
    flex: 1;
    height: 1px;
    background: color-mix(in srgb, var(--gold) 60%, transparent);
  }

  .ornament::before {
    margin-right: 6px;
  }

  .ornament::after {
    margin-left: 6px;
  }

  .cover-desc {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.55;
    color: color-mix(in srgb, var(--cream) 88%, transparent);
  }

  .hint {
    margin-top: auto;
    font-size: 0.72rem;
    font-style: italic;
    color: color-mix(in srgb, var(--gold) 70%, transparent);
  }

  .hint::before {
    content: 'Hover to open';
  }

  @media (hover: none) {
    .hint::before {
      content: 'Tap to open';
    }
  }

  /* Inside of the cover: coffee-marbled endpaper with a bookplate */
  .cover-inside {
    transform: rotateY(180deg);
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(ellipse 60% 40% at 25% 30%, rgba(111, 78, 55, 0.55), transparent 70%),
      radial-gradient(ellipse 50% 35% at 75% 65%, rgba(166, 124, 82, 0.5), transparent 70%),
      radial-gradient(ellipse 40% 30% at 40% 85%, rgba(92, 64, 51, 0.5), transparent 70%),
      #d9c3a0;
  }

  .bookplate {
    padding: 14px 18px;
    border: 1px solid rgba(92, 64, 51, 0.6);
    background: #f3e6cc;
    color: #5c4033;
    font-size: 0.75rem;
    font-style: italic;
    text-align: center;
    line-height: 1.5;
  }

  /* Open: cover swings past 90° on its spine, contents follow in.
     Touch screens only use .is-open: a tapped element keeps :hover until the
     next tap elsewhere, which would stop the close button from closing it. */
  .book.is-open .book-cover {
    transform: rotateY(-100deg);
    pointer-events: none;
  }

  .book.is-open :is(.toc li, .page-foot) {
    opacity: 1;
    transform: none;
    transition-duration: 0.35s;
    transition-delay: calc(0.3s + var(--i) * 0.07s);
  }

  @media (hover: hover) {
    .book:is(:hover, :focus-within) .book-cover {
      transform: rotateY(-100deg);
      pointer-events: none;
    }

    .book:is(:hover, :focus-within) :is(.toc li, .page-foot) {
      opacity: 1;
      transform: none;
      transition-duration: 0.35s;
      transition-delay: calc(0.3s + var(--i) * 0.07s);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .book-cover,
    .sheet,
    .toc li,
    .page-foot {
      transition-duration: 0s !important;
      transition-delay: 0s !important;
    }
  }
</style>

<script>
  const books = [...document.querySelectorAll<HTMLElement>('.book')];
  const resets = new Map<HTMLElement, () => void>();

  // Page flipping: buttons everywhere, swipe on touch screens
  books.forEach((book) => {
    const sheets = [...book.querySelectorAll<HTMLElement>('.sheet')];
    const prev = book.querySelector<HTMLButtonElement>('.flip.prev');
    const next = book.querySelector<HTMLButtonElement>('.flip.next');
    const cur = book.querySelector('.page-num .cur');
    let page = 0;

    const go = (n: number) => {
      n = Math.max(0, Math.min(sheets.length - 1, n));
      if (n === page) return;
      page = n;
      sheets.forEach((sheet, i) => {
        sheet.classList.toggle('turned', i < page);
        sheet.inert = i !== page;
      });
      if (prev) prev.disabled = page === 0;
      if (next) next.disabled = page === sheets.length - 1;
      if (cur) cur.textContent = String(page + 1);
    };
    resets.set(book, () => go(0));

    prev?.addEventListener('click', () => go(page - 1));
    next?.addEventListener('click', () => go(page + 1));

    if (sheets.length > 1) {
      const pageEl = book.querySelector<HTMLElement>('.book-page');
      let x0 = 0;
      let y0 = 0;
      pageEl?.addEventListener('touchstart', (e) => {
        x0 = e.touches[0].clientX;
        y0 = e.touches[0].clientY;
      }, { passive: true });
      pageEl?.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - x0;
        const dy = e.changedTouches[0].clientY - y0;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) go(page + (dx < 0 ? 1 : -1));
      });
    }

    // With a mouse, return to the first page once the book has closed
    let leaveTimer: number | undefined;
    book.addEventListener('mouseleave', () => {
      if (book.contains(document.activeElement)) (document.activeElement as HTMLElement).blur();
      leaveTimer = window.setTimeout(() => go(0), 900);
    });
    book.addEventListener('mouseenter', () => clearTimeout(leaveTimer));
  });

  const closeAll = (except?: HTMLElement) => {
    books.forEach((b) => {
      if (b !== except && b.classList.contains('is-open')) {
        b.classList.remove('is-open');
        window.setTimeout(() => resets.get(b)?.(), 600);
      }
    });
  };

  // Touch screens can't hover: tap a book to open it; close it with the ×,
  // by tapping outside it, or with Escape
  if (window.matchMedia('(hover: none)').matches) {
    books.forEach((book) => {
      book.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('.book-close')) {
          closeAll();
          return;
        }
        if (target.closest('button')) return; // page flips
        if (book.classList.contains('is-open')) return; // links on the open page work as normal
        e.preventDefault(); // a tap on the closed cover opens it instead of following the title link
        closeAll(book);
        book.classList.add('is-open');
      });
    });
    document.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('.book')) closeAll();
    });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAll();
  });
</script>
