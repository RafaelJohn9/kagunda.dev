---
import type { CollectionEntry } from 'astro:content';
import { getFolders } from '../folders';

export interface Props {
  post: CollectionEntry<'blog'>;
  // On a folder's own page: lead with the chapter number and skip the volume line.
  numbered?: boolean;
}

const { post, numbered = false } = Astro.props;
const { title, description, pubDate, tags = [] } = post.data;

// Which book (folder) this post sits in, and where
const folders = await getFolders();
const volume = folders.findIndex((f) => f.id === post.data.series);
const folder = volume >= 0 ? folders[volume] : undefined;
const chapter = folder ? folder.posts.findIndex((p) => p.id === post.id) + 1 : 0;

// Reading time, measured in coffee
const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 230));
const brew = minutes <= 6 ? 'an espresso' : minutes <= 15 ? 'a cup' : 'a pot';

// Difficulty tags become coffee beans; the rest are subjects
const LEVELS = ['beginner', 'intermediate', 'advanced'];
const level = LEVELS.findIndex((l) => tags.map((t) => t.toLowerCase()).includes(l)) + 1;
const subjects = tags
  .filter((t) => !LEVELS.includes(t.toLowerCase()))
  .slice(0, 4)
  .map((t) => t.replace(/-/g, ' '));

const day = pubDate.toLocaleDateString('en-US', { day: 'numeric' });
const monthYear = pubDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---

<a
  href={`/blog/${post.id}`}
  class:list={['entry', { numbered }]}
  style={folder ? `--ribbon: ${folder.color}` : undefined}
>
  <span class="stamp">
    {numbered && chapter ? (
      <>
        <span class="big">#{chapter}</span>
        <span class="small">{monthYear}</span>
      </>
    ) : (
      <>
        <span class="big">{day}</span>
        <span class="small">{monthYear}</span>
      </>
    )}
  </span>

  <span class="body">
    {folder && !numbered && (
      <span class="volume">
        <span class="swatch" aria-hidden="true"></span>
        Vol. {String(volume + 1).padStart(2, '0')} · {folder.title} · Chapter #{chapter}
      </span>
    )}
    <span class="title">{title}</span>
    <span class="excerpt">{description}</span>
    <span class="meta">
      <span class="brew" title={`About ${minutes} minutes`}>
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path class="steam" d="M8 2c0 1.5 1 1.5 1 3M12 2c0 1.5 1 1.5 1 3" />
          <path d="M4 8h13v5a6 6 0 0 1-6 6h-1a6 6 0 0 1-6-6V8z" />
          <path d="M17 10h1.5a2.5 2.5 0 0 1 0 5H17" />
          <path d="M3 22h16" />
        </svg>
        {minutes} min · {brew}
      </span>
      {level > 0 && (
        <span class="beans" title={LEVELS[level - 1]} aria-label={`Level: ${LEVELS[level - 1]}`}>
          {LEVELS.map((_, i) => (
            <svg viewBox="0 0 10 14" width="9" height="12" aria-hidden="true" class:list={{ roasted: i < level }}>
              <ellipse cx="5" cy="7" rx="4.2" ry="6.2" />
              <path d="M5 1.2c-1.8 2.4 1.8 4.6 0 11.6" fill="none" />
            </svg>
          ))}
        </span>
      )}
      {subjects.length > 0 && <span class="subjects">{subjects.join(' · ')}</span>}
    </span>
  </span>

  <span class="ribbon" aria-hidden="true"></span>
</a>

<style>
  .entry {
    --ribbon: var(--accent-color);
    position: relative;
    display: grid;
    grid-template-columns: 76px 1fr;
    gap: 24px;
    padding: 24px 56px 24px 16px;
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid var(--border-color);
    border-radius: 6px;
    overflow: hidden;
    transition: background-color 0.3s ease;
  }

  .entry:first-child {
    border-top: 1px solid var(--border-color);
  }

  .entry:hover,
  .entry:focus-visible {
    background: color-mix(in srgb, var(--card-bg-color) 80%, var(--accent-color) 6%);
  }

  /* Date (or chapter) stamp, set like a library due-date stamp */
  .stamp {
    display: flex;
    flex-direction: column;
    align-items: center;
    align-self: start;
    padding: 8px 4px 10px;
    border: 1px solid var(--border-color);
    border-radius: 4px;
    text-align: center;
    transition: transform 0.35s ease, border-color 0.35s ease;
  }

  .entry:hover .stamp {
    transform: rotate(-4deg);
    border-color: var(--accent-color);
  }

  .stamp .big {
    font-family: 'Playfair Display', serif;
    font-size: 1.9rem;
    font-weight: 700;
    line-height: 1;
    color: var(--heading-color);
  }

  .stamp .small {
    margin-top: 6px;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .volume {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-color);
  }

  .swatch {
    flex-shrink: 0;
    width: 8px;
    height: 12px;
    border-radius: 1px 2px 2px 1px;
    background: var(--ribbon);
    box-shadow: inset 2px 0 0 rgba(0, 0, 0, 0.3);
  }

  .title {
    width: fit-content;
    font-family: 'Playfair Display', serif;
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--heading-color);
    /* underline that draws in on hover */
    background: linear-gradient(var(--accent-color), var(--accent-color)) left bottom / 0 1px no-repeat;
    transition: background-size 0.4s ease;
  }

  .entry:hover .title,
  .entry:focus-visible .title {
    background-size: 100% 1px;
  }

  .excerpt {
    margin: 8px 0 12px;
    font-size: 0.95rem;
    font-style: italic;
    line-height: 1.6;
    opacity: 0.85;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 18px;
    font-size: 0.78rem;
  }

  .brew {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    color: var(--heading-color);
  }

  .brew .steam {
    opacity: 0;
    transform: translateY(2px);
    transition: opacity 0.4s ease, transform 0.6s ease;
  }

  .entry:hover .brew .steam {
    opacity: 1;
    transform: none;
  }

  .beans {
    display: inline-flex;
    gap: 3px;
  }

  .beans svg {
    fill: transparent;
    stroke: color-mix(in srgb, var(--text-color) 40%, transparent);
    stroke-width: 1;
  }

  .beans svg.roasted {
    fill: var(--accent-color);
    stroke: var(--heading-color);
  }

  .beans svg path {
    stroke: var(--card-bg-color);
  }

  .beans svg:not(.roasted) path {
    stroke: color-mix(in srgb, var(--text-color) 40%, transparent);
  }

  .subjects {
    font-variant: small-caps;
    letter-spacing: 0.04em;
    opacity: 0.7;
  }

  /* Leather bookmark ribbon that drops in on hover */
  .ribbon {
    position: absolute;
    top: 0;
    right: 22px;
    width: 16px;
    height: 46px;
    background: var(--ribbon);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 78%, 0 100%);
    transform: translateY(-100%);
    transition: transform 0.45s cubic-bezier(0.3, 1.4, 0.5, 1);
  }

  .entry:hover .ribbon,
  .entry:focus-visible .ribbon {
    transform: translateY(0);
  }

  @media (max-width: 600px) {
    .entry {
      grid-template-columns: 56px 1fr;
      gap: 14px;
      padding: 20px 36px 20px 6px;
    }
    .stamp .big {
      font-size: 1.4rem;
    }
    .title {
      font-size: 1.1rem;
    }
    .ribbon {
      right: 10px;
      width: 13px;
      height: 36px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .entry *,
    .entry {
      transition-duration: 0s !important;
    }
  }
</style>
